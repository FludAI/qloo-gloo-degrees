# Copy to .env (never commit .env). Server-side only; nothing here reaches the browser.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# Locally, `qloo setup --qloo` stores the Qloo key privately and you can leave this unset.
# QLOO_API_KEY=
# Claude powers the cue agent, camera reading and lesson drafting. Unset = those show "unavailable"; reviewed lessons still work.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# The second model backend (degrees site): Meta Model API key for the muse arm; unset = that arm falls back to Claude.
# META_API_KEY=
# META_REASONING_EFFORT=low
# META_REASONING_HEADROOM=6000
# META_MODEL=muse-spark-1.3
# MODEL_ARMS=anthropic,muse
PORT=8787
# 1 = labeled fixture data and a synthetic agent, no Qloo, model or speech calls.
QLOO_MOCK=0
# Spoken capture uses Google Cloud Speech-to-Text through Application Default Credentials
# (the Cloud Run service account; locally `gcloud auth application-default login`). Without
# credentials the browser's own speech recognition is used where it exists. 1 = never use the server service.
# STT_DISABLE=0
# The app's voice: Google Cloud Text-to-Speech through the same credentials; without them the browser's own
# voice speaks. Clips are kept in a Cloud Storage bucket (MEDIA_BUCKET) so each line is paid for once ever;
# without credentials they go to server/data/media/. 1 = never use the server voice.
# TTS_DISABLE=0
# TTS_VOICE=en-US-Neural2-F
# MEDIA_BUCKET=gloo-media-bondswipe
# MEDIA_LOCAL=0
# Hosted demo gate: camera, voice, the agent and drafting need this passcode once per session. Unset = open.
# DEMO_PASSCODE=
# Owner token for the lesson API (/api/admin/lessons) and the /edit console, sent as the x-gloo-admin header.
# Separate from the passcode. Unset = owner API off (503). Lessons live in the media bucket under lessons/.
# ADMIN_TOKEN=
# Windows: full path to the harness shim when the server's PATH lacks the Node global bin.
# QLOO_BIN=C:/Users/you/AppData/Roaming/nvm/v22.20.0/qloo.cmd
# Optional: a module outside this repo that exports extra `terms`.
# GLOO_ENGINE_MODULE=../gloo-engine/index.mjs
