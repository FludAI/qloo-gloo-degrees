{
  "name": "@qloo-gloo/server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/boot.mjs",
    "dev:mock": "node --env-file-if-exists=../.env --watch src/index.mjs --mock",
    "start": "node --env-file-if-exists=../.env src/boot.mjs",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@google-cloud/storage": "8.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "dictionary-en": "4.0.0",
    "double-metaphone": "2.0.1",
    "express": "4.22.3",
    "fastest-levenshtein": "1.0.16",
    "google-auth-library": "^10.5.0",
    "nspell": "2.1.5"
  }
}
